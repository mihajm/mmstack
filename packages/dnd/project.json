{
  "name": "dnd",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/dnd/src",
  "prefix": "mm",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/dnd/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/dnd/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/dnd/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "isolate": true,
        "exclude": ["**/*.browser.spec.ts"]
      }
    },
    "test-browser": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "include": ["**/*.browser.spec.ts"],
        "browsers": ["chromiumHeadless"]
      },
      "configurations": {
        "webkit": { "browsers": ["webkitHeadless"] },
        "firefox": { "browsers": ["firefoxHeadless"] }
      }
    },
    "mutate": {
      "executor": "./tools/stryker:mutate",
      "options": {
        "exclude": ["packages/dnd/src/lib/testing/**"]
      }
    },
    "mutate-report": {
      "executor": "./tools/stryker:mutate-report",
      "options": {
        "exclude": ["packages/dnd/src/lib/testing/**"]
      }
    }
  }
}
