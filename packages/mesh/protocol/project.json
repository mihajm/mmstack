{
  "name": "mesh-protocol",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/mesh/protocol/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/mesh/protocol"],
      "options": {
        "cwd": "packages/mesh/protocol",
        "parallel": false,
        "commands": [
          "tsdown",
          "cp package.json README.md ../../../dist/packages/mesh/protocol/"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/mesh/protocol"
      }
    }
  }
}
