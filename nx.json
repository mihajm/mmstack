{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/oxlint.config.mts"],
    "sharedGlobals": []
  },
  "nxCloudId": "67e0fa0bd158442904e10d69",
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "watch": false
      }
    },
    "@nx/angular:unit-test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "watch": false
      }
    },
    "@nx/angular:package": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/oxlint:lint": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/oxlint.config.mts",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "externalDependencies": ["oxlint", "oxlint-tsgolint", "@nx/oxlint"]
        }
      ]
    },
    "mutate": {
      "cache": false,
      "parallelism": false
    },
    "mutate-report": {
      "cache": false,
      "parallelism": false
    }
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "linter": "none",
      "style": "scss",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:library": {
      "linter": "none",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:component": {
      "style": "css"
    }
  },
  "plugins": [
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "analytics": false
}
