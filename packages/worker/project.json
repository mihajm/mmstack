{
  "name": "worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/worker/src",
  "prefix": "mm",
  "projectType": "library",
  "tags": ["scope:worker"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/worker/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/worker/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/worker/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "include": ["**/*.spec.ts", "**/*.test.ts"],
        "exclude": ["**/*.browser.spec.ts"]
      }
    },
    "test-browser": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "include": ["**/*.browser.spec.ts"],
        "browsers": ["chromiumHeadless"],
        "runnerConfig": "packages/worker/vitest-browser.config.mts"
      },
      "configurations": {
        "webkit": { "browsers": ["webkitHeadless"] },
        "firefox": { "browsers": ["firefoxHeadless"] }
      }
    },
    "mutate": {
      "executor": "./tools/stryker:mutate"
    },
    "mutate-report": {
      "executor": "./tools/stryker:mutate-report"
    }
  }
}
