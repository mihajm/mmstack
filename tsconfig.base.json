{
  "compilerOptions": {
    "rootDir": ".",
    "isolatedModules": true,
    "sourceMap": true,
    "declaration": false,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "emitDecoratorMetadata": false,
    "importHelpers": true,
    "target": "es2025",
    "moduleResolution": "bundler",
    "module": "preserve",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "paths": {
      "@mmstack/form-adapters": ["./packages/form/adapters/src/index.ts"],
      "@mmstack/form-core": ["./packages/form/core/src/index.ts"],
      "@mmstack/form-material": ["./packages/form/material/src/index.ts"],
      "@mmstack/form-validation": ["./packages/form/validation/src/index.ts"],
      "@mmstack/local": ["./packages/local/src/index.ts"],
      "@mmstack/mesh": ["./packages/mesh/client/src/index.ts"],
      "@mmstack/mesh-protocol": ["./packages/mesh/protocol/src/index.ts"],
      "@mmstack/primitives": ["./packages/primitives/src/index.ts"],
      "@mmstack/resource": ["./packages/resource/src/index.ts"],
      "@mmstack/router-core": ["./packages/router/core/src/index.ts"],
      "@mmstack/telemetry-core": ["./packages/telemetry/core/src/index.ts"],
      "@mmstack/telemetry-otel": ["./packages/telemetry/otel/src/index.ts"],
      "@mmstack/telemetry-posthog": ["./packages/telemetry/posthog/src/index.ts"],
      "@mmstack/telemetry-sentry": ["./packages/telemetry/sentry/src/index.ts"],
      "@mmstack/translate": ["./packages/translate/src/index.ts"],
      "@mmstack/di": ["./packages/di/src/index.ts"],
      "@mmstack/dnd": ["./packages/dnd/src/index.ts"],
      "@mmstack/dnd/plugins": ["./packages/dnd/plugins/src/index.ts"],
      "@mmstack/forms": ["./packages/forms/src/index.ts"],
      "@mmstack/translate-tools": ["./packages/translate-tools/src/index.ts"],
      "@mmstack/worker": ["./packages/worker/src/index.ts"],
      "@mmstack/worker/host": ["./packages/worker/host/src/index.ts"],
      "@mmstack/worker/protocol": ["./packages/worker/protocol/src/index.ts"],
      "@mmstack/demos": ["./libs/demos/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictStandalone": true,
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "exclude": ["node_modules", "tmp"]
}
