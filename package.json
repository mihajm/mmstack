{
  "name": "@mmstack/source",
  "version": "0.0.0",
  "license": "MIT",
  "keywords": [
    "angular",
    "signals",
    "forms",
    "resource",
    "table",
    "router",
    "cache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihajm/mmstack.git"
  },
  "homepage": "https://github.com/mihajm/mmstack/blob/master",
  "packageManager": "pnpm@12.2.1",
  "private": true,
  "scripts": {
    "start": "pnpm --parallel run \"/^serve:/\"",
    "serve:playground": "nx serve playground --port=4201",
    "serve:docs": "nx serve docs",
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=test",
  "check:node": "node scripts/check-node-load.mjs @mmstack/primitives/core @mmstack/di @mmstack/worker/host @mmstack/worker/protocol @mmstack/mesh-protocol @mmstack/mesh",
    "idea:backup": "git add -f idea/ && git update-ref refs/heads/idea-vault $(git commit-tree $(git write-tree) $(git rev-parse -q --verify idea-vault >/dev/null 2>&1 && printf -- '-p idea-vault') -m \"backup: refresh idea $(date +%F)\") && git restore --staged idea/"
  },
