{
  "name": "@mmstack/source",
  "version": "0.0.0",
  "license": "MIT",
  "keywords": [
    "angular",
    "signals",
    "forms",
    "resource",
    "table",
    "router",
    "cache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihajm/mmstack.git"
  },
  "homepage": "https://github.com/mihajm/mmstack/blob/master",
  "packageManager": "pnpm@12.21.0",
  "private": true,
  "scripts": {
    "start": "pnpm --parallel run \"/^serve:/\"",
    "serve:playground": "nx serve playground --port=4201",
    "serve:docs": "nx serve docs",
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=test",
    "lint": "nx run-many --target=lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:node": "node scripts/check-node-load.mjs @mmstack/primitives/core @mmstack/di @mmstack/worker/host @mmstack/worker/protocol @mmstack/mesh-protocol @mmstack/mesh",
    "check:deps": "node scripts/check-deps.mjs",
    "idea:backup": "git add -f idea/ && git update-ref refs/heads/idea-vault $(git commit-tree $(git write-tree) $(git rev-parse -q --verify idea-vault >/dev/null 2>&1 && printf -- '-p idea-vault') -m \"backup: refresh idea $(date +%F)\") && git restore --staged idea/"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/ssr": "^22.2.7",
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-flourish": "^3.2.5",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-live-region": "^2.1.0",
    "@formatjs/icu-messageformat-parser": "^3.5.23",
    "@formatjs/intl": "^6.1.6",
    "hono": "^4.13.19",
    "idb-keyval": "^6.3.0",
    "rxjs": "^7.8.2",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.7",
    "@angular-devkit/schematics": "^22.2.7",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/language-server": "^22.2.6",
    "@angular/language-service": "^22.2.6",
    "@nx/angular": "^24.0.6",
    "@nx/js": "^24.0.6",
    "@nx/oxlint": "24.0.6",
    "@nx/playwright": "^24.0.6",
    "@nx/vite": "^24.0.6",
    "@nx/web": "^24.0.6",
    "@nx/workspace": "^24.0.6",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@playwright/test": "^1.65.1",
    "@schematics/angular": "^22.2.7",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.24",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "5.1.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "ng-packagr": "^22.2.6",
    "ngx-vflow": "^2.7.0",
    "nx": "^24.0.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "shiki": "^4.6.0",
    "tsdown": "^0.23.7",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "uuid": "^14.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  },
  "nx": {
    "includedScripts": []
  }
}
